# Copia este archivo a .env y completa los valores. .env NO se sube al repo.

# ---- Servidor ----
API_PORT=5120

# ---- Base de datos: el PostgreSQL de Yankees, base nueva "matrices" ----
# host.docker.internal = el PostgreSQL del mismo servidor.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=matrices
DB_USER=quantis
# La misma contraseña de quantis que usa Yankees (DB_PASSWORD de ~/yankees-api/.env).
DB_PASSWORD=

# ---- Sesión (obligatorio, mínimo 32 caracteres): openssl rand -base64 48 ----
JWT_SECRET=
JWT_DAYS=30

# ---- Google: client id(s) aceptados, separados por coma ----
# El client id WEB (lo usan web, Android e iOS como serverClientId).
GOOGLE_CLIENT_IDS=633999953572-814g0n5hc3d30m3b4svk88k2sr9sdjsg.apps.googleusercontent.com

# ---- App web (CORS), separados por coma, sin "/" final ----
CORS_ORIGINS=https://matrices.quantis.site
# true solo en desarrollo (flutter run -d chrome).
CORS_ALLOW_LOCALHOST=false

# ---- OCR (opcional) ----
# OCR_ENABLED=true
# OCR_TIMEOUT_SECONDS=20
# OCR_MAX_CONCURRENCY=1
# MAX_UPLOAD_MB=8

# ---- APK de Android (landing) ----
# Clave para subir un APK nuevo desde https://matrices.quantis.site/subir
# (mínimo 16 caracteres): openssl rand -base64 24
APK_UPLOAD_KEY=
# MAX_APK_MB=150
# Carpeta del servidor donde se guarda (la memoria USB, no el disco interno).
DATA_PATH=/mnt/minecraft-usb/matrices/data
